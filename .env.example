# ═══════════════════════════════════════════════
# БЭКЕНД (Render / Railway / VPS) — server.js
# ═══════════════════════════════════════════════

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGO_DB_NAME=lipovoy

# AWS S3 (загрузка фото/видео)
AWS_BUCKET_NAME=your-bucket
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=eu-north-1

# Сервер
PORT=4000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=your-secure-password

# CORS — URL фронтенда на Vercel (через запятую, если несколько)
FRONTEND_URL=https://your-site.vercel.app

# Telegram-оплата
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_ORDERS_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_PAYMENT_DETAILS=Карта: 2200 .... .... ....\nПолучатель: Имя Ф.

# ═══════════════════════════════════════════════
# ФРОНТЕНД (Vercel) — только VITE_* попадают в билд
# ═══════════════════════════════════════════════

# URL бэкенда (без слэша в конце). На Vercel можно не задавать — /api проксируется в vercel.json
VITE_API_URL=https://back-lipovoy.vercel.app
